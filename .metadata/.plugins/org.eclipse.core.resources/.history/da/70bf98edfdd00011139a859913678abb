
package com.klef.soa.exam.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.klef.soa.exam.entity.FurnitureRental;
import com.klef.soa.exam.repository.FurnitureRentalRepository;

@Service
public class FurnitureRentalServiceImpl implements FurnitureRentalService
{
    @Autowired
    private FurnitureRentalRepository repo;

    @Override
    public FurnitureRental addFurnitureRental(FurnitureRental furnitureRental)
    {
        return repo.save(furnitureRental);
    }

    @Override
    public List<FurnitureRental> displayAllFurnitureRentals()
    {
        return repo.findAll();
    }

    @Override
    public String deleteFurnitureRentalById(Long id)
    {
        boolean status = repo.existsById(id);

        if (status)
        {
            repo.deleteById(id);
            return "Furniture Rental Deleted Successfully";
        }
        else
        {
            return "Furniture Rental ID Not Found";
        }
    }
    

		@Override
		public FurnitureRental displayFurnitureRentalById(Long id)
		{
		    return repo.findById(id).orElse(null);
		}
		
		@Override
		public FurnitureRental updateFurnitureRental(Long id, FurnitureRental furnitureRental)
		{
		    FurnitureRental fr = repo.findById(id).orElse(null);
		
		    if (fr != null)
		    {
		        fr.setFurnituretype(furnitureRental.getFurnituretype());
		        fr.setRentalPeriod(furnitureRental.getRentalPeriod());
		        fr.setMonthlyrent(furnitureRental.getMonthlyrent());
		        fr.setAvailable(furnitureRental.isAvailable());
		
		        return repo.save(fr);
		    }
		
		    return null;
		}

}
